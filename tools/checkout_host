#!/bin/sh
# A cloned Neurath source tree bootstraps its own host runtime on first use.
set -eu
root=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd -P)
cd "$root"
if [ ! -x .neurath/run ] || [ ! -f .neurath/install.json ]; then
    # Bootstrap missing installations only. Source changes are validated before
    # an explicit ./setup --self updates the immutable runtime. The installer
    # serializes concurrent initial setup; preserve its failure instead of polling.
    ./setup --self >&2
fi
[ -x .neurath/run ] && [ -f .neurath/install.json ] || {
    echo 'Neurath bootstrap did not complete installation' >&2
    exit 1
}
if [ "${1:-}" = mcp ]; then
    shift
    exec .neurath/run __mcp "$@"
fi
exec .neurath/run "$@"
