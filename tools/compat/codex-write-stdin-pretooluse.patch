+#[test_case::test_case(""; "poll")]
+#[test_case::test_case("hello\n"; "stdin")]
+#[tokio::test]
+async fn pre_tool_use_blocks_nested_write_stdin_before_input(chars: &str) -> Result<()> {
+    skip_if_no_network!(Ok(()));
+    skip_if_host_windows!(Ok(()));
+    let server = start_mock_server().await;
+    let call_id = "pretooluse-code-mode-stdin-block";
+    let marker_dir = TempDir::new().context("create stdin block marker directory")?;
+    let marker = marker_dir.path().join("received-input");
+    let command = format!("read line; printf received > {}", marker.display());
+    let command_json = serde_json::to_string(&command)?;
+    let chars_json = serde_json::to_string(chars)?;
+    let code = format!(
+        r#"
+const started = await tools.exec_command({{ cmd: {command_json}, shell: "/bin/sh", login: false, tty: true, yield_time_ms: 250 }});
+if (started.session_id !== 1000) throw new Error("expected live session: " + JSON.stringify(started));
+text("nonwaiting nested exec started");
+try {{
+  const result = await tools.write_stdin({{ session_id: 1000, chars: {chars_json}, yield_time_ms: 1000 }});
+  text(JSON.stringify({{ kind: "unexpected-success", result }}));
+}} catch (error) {{
+  text(JSON.stringify({{ kind: "caught", error: String(error) }}));
+}}
+"#
+    );
+    let responses = mount_sse_sequence(
+        &server,
+        vec![
+            sse(vec![
+                ev_response_created("resp-1"),
+                ev_custom_tool_call(call_id, "exec", &code),
+                ev_completed("resp-1"),
+            ]),
+            sse(vec![
+                ev_response_created("resp-2"),
+                ev_assistant_message("msg-1", "stdin gate observed"),
+                ev_completed("resp-2"),
+            ]),
+        ],
+    )
+    .await;
+    let reason = "dispatch ready wave work before polling";
+    let mut builder = test_codex()
+        .with_model("test-gpt-5.1-codex")
+        .with_pre_build_hook(move |home| {
+            write_pre_tool_use_hook(home, Some("^write_stdin$"), "json_deny", reason)
+                .expect("write stdin blocking hook");
+        })
+        .with_config(|config| {
+            let _ = config.features.enable(Feature::CodeMode);
+            let _ = config.features.enable(Feature::CodeModeHost);
+            trust_discovered_hooks(config);
+        });
+    let test = builder.build(&server).await?;
+    test.submit_turn_with_permission_profile("run nested stdin", PermissionProfile::Disabled)
+        .await?;
+    let requests = responses.requests();
+    assert_eq!(requests.len(), 2);
+    let output = code_mode_custom_tool_output_text(&requests[1].custom_tool_call_output(call_id));
+    assert!(
+        output.contains("nonwaiting nested exec started"),
+        "{output}"
+    );
+    assert!(output.contains(reason), "{output}");
+    assert!(!output.contains("unexpected-success"));
+    assert!(!marker.exists(), "denied stdin must not reach the process");
+    let inputs = read_pre_tool_use_hook_inputs(test.codex_home_path())?;
+    assert_eq!(inputs.len(), 1);
+    assert_eq!(inputs[0]["tool_name"], "write_stdin");
+    assert_eq!(inputs[0]["tool_input"]["session_id"], 1000);
+    Ok(())
+}
